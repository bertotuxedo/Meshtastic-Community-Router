# MQTT broker connection
MCR_MQTT_HOST=mqtt.example.com
MCR_MQTT_PORT=1883
MCR_MQTT_USERNAME=CHANGE_ME
MCR_MQTT_PASSWORD=CHANGE_ME

# Meshtastic channel PSK encoded as Base64
MCR_FATS_PSK_BASE64=CHANGE_ME

# Enable packet routing
MCR_ROUTING_ENABLED=true

# Enable FATBOT command responses
MCR_BOT_RESPONSES_ENABLED=true

# SQLite database path inside the container
MCR_DATABASE=/data/router.db
